{
    "name": "wazum/visual-permissions",
    "type": "typo3-cms-extension",
    "description": "Edit TYPO3 backend group permissions directly on the relevant screens.",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Wolfgang Klinger",
            "email": "wolfgang@wazum.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "typo3/cms-backend": "^13.4 || ^14.3",
        "typo3/cms-beuser": "^13.4 || ^14.3",
        "typo3/cms-core": "^13.4 || ^14.3",
        "typo3/cms-fluid": "^13.4 || ^14.3"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7",
        "dg/bypass-finals": "^1.9",
        "friendsofphp/php-cs-fixer": "^3.65",
        "infection/infection": "^0.29",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.1",
        "rector/rector": "^2.0",
        "saschaegerer/phpstan-typo3": "^2.1",
        "savinmikhail/annotate_throws_rector": "^0.1.5",
        "typo3/cms-filelist": "^13.4 || ^14.3",
        "typo3/cms-install": "^13.4 || ^14.3",
        "typo3/testing-framework": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "Wazum\\VisualPermissions\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wazum\\VisualPermissions\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "visual_permissions",
            "version": "0.1.0-alpha",
            "Package": {
                "providesPackages": {}
            }
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "phpstan/extension-installer": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test:unit": "phpunit -c phpunit.xml.dist",
        "test:functional": "phpunit -c phpunit.functional.xml.dist",
        "test:mutation": "infection --configuration=infection.json5 --show-mutations",
        "test:e2e:seed": "php Tests/E2e/seed/seed.php",
        "test": [
            "@test:unit",
            "@test:functional"
        ],
        "phpstan": "phpstan analyse -c phpstan.neon.dist",
        "deptrac": "deptrac analyse --config-file=deptrac.yaml --no-progress",
        "php-cs-fixer": "php-cs-fixer fix --config=php-cs-fixer.config.php --dry-run --diff",
        "php-cs-fixer:fix": "php-cs-fixer fix --config=php-cs-fixer.config.php",
        "rector": "rector process --dry-run --clear-cache",
        "rector:fix": "rector process --clear-cache",
        "qa": [
            "@php-cs-fixer",
            "@rector",
            "@phpstan",
            "@deptrac"
        ],
        "qa:fix": [
            "@rector:fix",
            "@php-cs-fixer:fix"
        ]
    },
    "scripts-descriptions": {
        "test:functional": "Functional suite; needs typo3DatabaseDriver=pdo_sqlite in the environment.",
        "test:mutation": "Infection over Classes; needs a coverage driver (ddev xdebug on, XDEBUG_MODE=coverage).",
        "test:e2e:seed": "Builds the browser suite's own TYPO3 on SQLite: schema, records and a backend session. Run once, and again when the fixture changes."
    }
}
